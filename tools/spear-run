FLASHLIGHT_BOOLEAN_FLAGS = {"--enable-flashlight", "--disable-flashlight"}
AUTO_EXPOSURE_BOOLEAN_FLAGS = {"--enable-auto-exposure", "--disable-auto-exposure"}
BOOLEAN_FLAG_GROUPS = (
    FLASHLIGHT_BOOLEAN_FLAGS,
    AUTO_EXPOSURE_BOOLEAN_FLAGS,
)

VISIBLE_BY_DEFAULT_STATUSES = {
    "preferred-baseline",
    "preferred-needs-live-validation",
    "preferred-orbit-validation",
    "runnable",
    "needs-runtime-visual-validation",
    "usable",
    "utility",
}


def repo_root() -> Path:
    return Path(__file__).resolve().parents[1]


def ledger_path() -> Path:
    return repo_root() / "docs" / "environment_ledger.json"


def load_ledger() -> dict:
    with ledger_path().open("r", encoding="utf-8") as f:
        return json.load(f)


def environments_by_alias() -> dict[str, dict]:
    ledger = load_ledger()
    return {env["alias"]: env for env in ledger["environments"]}


def strip_arg_separator(args: list[str]) -> list[str]:
    if args and args[0] == "--":
        return args[1:]
    return args


def fail(message: str, exit_code: int = 2) -> int:
    print(message, file=sys.stderr)
    return exit_code


def get_environment(alias: str) -> dict:
    env = environments_by_alias().get(alias)
    if env is None:
        raise ValueError(f"Unknown environment: {alias}. Run `spear env list` to see known aliases.")
    return env


def map_args_for(env: dict, supported_aliases: set[str]) -> list[str]:
    alias = env["alias"]
    if alias in supported_aliases:
        return ["--map", alias]
    map_path = env.get("unreal_map_path")
    if map_path:
        return ["--map-path", map_path]
    raise ValueError(
        f"Environment {alias!r} has no runnable Unreal map path. "
        "Run `spear env list --all` to inspect available environments."
    )


def live_setting_args_for(env: dict, setting: str) -> list[str]:
    overrides = (
        env.get("recommended_settings", {})
        .get("live_setting_overrides", {})
    )
    return list(overrides.get(setting, LIVE_SETTINGS[setting]))


def live_mode_args_for(env: dict, mode: str) -> list[str]:
    overrides = (
        env.get("recommended_settings", {})
        .get("live_setting_overrides", {})
    )
    if mode == "beacon":
        base_args = list(overrides.get("beacon", overrides.get("realistic", LIVE_MODES["beacon"])))
        return remove_args(
            base_args,
            FLASHLIGHT_BOOLEAN_FLAGS | AUTO_EXPOSURE_BOOLEAN_FLAGS,
        ) + ["--enable-flashlight", "--disable-auto-exposure"]
    base_args = list(overrides.get("default", LIVE_MODES[mode]))
    return remove_args(
        base_args,
        FLASHLIGHT_BOOLEAN_FLAGS | AUTO_EXPOSURE_BOOLEAN_FLAGS,
    ) + ["--enable-auto-exposure", "--disable-flashlight"]


def remove_args(args: list[str], flags: set[str]) -> list[str]:
    return [arg for arg in args if arg not in flags]


def resolve_boolean_passthrough(base_args: list[str], extra_args: list[str]) -> list[str]:
    resolved = list(base_args)
    for flag_group in BOOLEAN_FLAG_GROUPS:
        if any(flag in extra_args for flag in flag_group):
            resolved = remove_args(resolved, flag_group)
    return resolved + extra_args


def python_cmd(script: str, *args: str) -> list[str]:
    return ["python", script, *args]


def runtime_env() -> dict[str, str]:
    env = os.environ.copy()
    if sys.platform.startswith("linux") and "VK_ICD_FILENAMES" not in env:
        env["VK_ICD_FILENAMES"] = DEFAULT_LINUX_VK_ICD
    return env


def command_shell(argv: list[str]) -> str:
    return " && ".join(
        [
            f"cd {shlex.quote(str(repo_root()))}",
            f"source {shlex.quote(CONDA_SH)}",
            f"conda activate {shlex.quote(CONDA_ENV)}",
            "exec " + shlex.join(argv),
        ]
    )


def printable_command(argv: list[str]) -> str:
    prefix = []
    if sys.platform.startswith("linux") and "VK_ICD_FILENAMES" not in os.environ:
        prefix.append(f"VK_ICD_FILENAMES={shlex.quote(DEFAULT_LINUX_VK_ICD)}")
    return " ".join(prefix + ["bash", "-lc", shlex.quote(command_shell(argv))])


def run_or_print(argv: list[str], dry_run: bool) -> int:
    if dry_run:
        print(printable_command(argv))
        return 0
    return subprocess.run(
        ["bash", "-lc", command_shell(argv)],
        cwd=repo_root(),
        env=runtime_env(),
        check=False,
    ).returncode


def env_list(args: argparse.Namespace) -> int:
    ledger = load_ledger()
    environments = ledger["environments"]
    if not args.all:
        environments = [env for env in environments if env["status"] in VISIBLE_BY_DEFAULT_STATUSES]

    if args.json:
        print(json.dumps({"schema_version": ledger["schema_version"], "environments": environments}, indent=2))
        return 0

    for env in environments:
        map_path = env["unreal_map_path"] or "(no runnable map)"
        print(f"{env['alias']}\t{env['status']}\t{map_path}")
    return 0


def env_show(args: argparse.Namespace) -> int:
    try:
        env = get_environment(args.env)
    except ValueError as exc:
        return fail(str(exc))

    if args.json:
        print(json.dumps(env, indent=2))
        return 0

    print(f"alias: {env['alias']}")
    print(f"display_name: {env['display_name']}")
    print(f"status: {env['status']}")
    print(f"unreal_map_path: {env['unreal_map_path']}")
    print(f"local_umap_path: {env['local_umap_path']}")
    print(f"package_version: {env['package_version']}")
    return 0


def live(args: argparse.Namespace, extra_args: list[str]) -> int:
    try:
        env = get_environment(args.env)
        if args.setting is not None:
            if args.live_mode is not None:
                return fail("--setting cannot be combined with --default or --beacon.")
            if args.setting == "default":
                live_args = live_mode_args_for(env=env, mode="default")
            else:
                live_args = live_setting_args_for(env=env, setting=args.setting)
        else:
            live_args = live_mode_args_for(env=env, mode=args.live_mode or "default")
        argv = (
            python_cmd("examples/flashlight/run.py")
            + map_args_for(env, RUN_MAP_ALIASES)
            + resolve_boolean_passthrough(base_args=live_args, extra_args=extra_args)
        )
    except ValueError as exc:
        return fail(str(exc))
    return run_or_print(argv, args.dry_run)


def record(args: argparse.Namespace, extra_args: list[str]) -> int:
    try:
        env = get_environment(args.env)
        argv = (
            python_cmd("examples/flashlight/run.py")
            + map_args_for(env, RUN_MAP_ALIASES)
            + ["--capture-poses", "--movement-speed", "600"]
            + extra_args
        )
    except ValueError as exc:
        return fail(str(exc))
    return run_or_print(argv, args.dry_run)


