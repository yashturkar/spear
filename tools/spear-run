    try:
        env = get_environment(args.env)
        argv = (
            ["examples/flashlight/run_orbit_workflow.sh", "render"]
            + map_args_for(env, ORBIT_MAP_ALIASES)
            + ["--render-preset", args.preset]
            + extra_args
