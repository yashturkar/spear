def flythrough(args: argparse.Namespace, extra_args: list[str]) -> int:
    try:
        env = get_environment(args.env)
    except ValueError as exc:
        return fail(str(exc))
    if env["alias"] not in FLYTHROUGH_MAP_ALIASES:
        return fail(
            f"Environment {env['alias']!r} is not supported by examples/flashlight/render_flythrough.py. "
            f"Supported aliases: {', '.join(sorted(FLYTHROUGH_MAP_ALIASES))}."
        )
    argv = python_cmd("examples/flashlight/render_flythrough.py", "--map", env["alias"]) + extra_args
    return run_or_print(argv, args.dry_run)


def cook(args: argparse.Namespace) -> int:
    try:
        envs = [get_environment(alias) for alias in args.envs]
        map_paths = []
        for env in envs:
            map_path = env.get("unreal_map_path")
            if not map_path:
                raise ValueError(
                    f"Environment {env['alias']!r} has no runnable Unreal map path. "
                    "Run `spear env list --all` to inspect available environments."
                )
            map_paths.append(map_path)
    except ValueError as exc:
        return fail(str(exc))

    argv = [
        "python",
        "tools/run_uat.py",
        "--unreal-engine-dir",
        UNREAL_ENGINE_DIR,
        "--clean-archive-dir",
        "--cook-maps",
        *map_paths,
        "-clean",
        "-cook",
        "-stage",
        "-package",
        "-archive",
        "-pak",
        "-skipbuild",
    ]
    print(shlex.join(argv))
    if not args.dry_run:
        print("Cook command was not launched; long-running cooks remain Experimenter-managed.", file=sys.stderr)
    return 0


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="spear")
    subparsers = parser.add_subparsers(dest="command", required=True)

    env_parser = subparsers.add_parser("env", help="Inspect environment aliases")
    env_subparsers = env_parser.add_subparsers(dest="env_command", required=True)
    env_list_parser = env_subparsers.add_parser("list", help="List environment aliases")
    env_list_parser.add_argument("--json", action="store_true")
    env_list_parser.add_argument("--all", action="store_true")
    env_list_parser.set_defaults(func=lambda args, extra: env_list(args))
    env_show_parser = env_subparsers.add_parser("show", help="Show one environment")
    env_show_parser.add_argument("env")
    env_show_parser.add_argument("--json", action="store_true")
    env_show_parser.set_defaults(func=lambda args, extra: env_show(args))

    live_parser = subparsers.add_parser("live", help="Run flashlight live teleop")
    live_parser.add_argument("env")
    live_parser.add_argument(
        "--setting",
        choices=sorted(LIVE_SETTINGS.keys()),
        default=None,
        help="Deprecated compatibility setting. Prefer --default or --beacon.",
    )
    live_mode_group = live_parser.add_mutually_exclusive_group()
    live_mode_group.add_argument(
        "--default",
        dest="live_mode",
        action="store_const",
        const="default",
        default=None,
        help="Launch the environment normally without the camera flashlight.",
    )
    live_mode_group.add_argument(
        "--beacon",
        dest="live_mode",
        action="store_const",
        const="beacon",
        help="Launch with the realistic camera flashlight setup.",
    )
    live_parser.add_argument("--dry-run", action="store_true")
    live_parser.set_defaults(func=lambda args, extra: live(args, extra))

    record_parser = subparsers.add_parser("record", help="Run flashlight teleop with pose capture")
    record_parser.add_argument("env")
    record_parser.add_argument("--dry-run", action="store_true")
    record_parser.set_defaults(func=lambda args, extra: record(args, extra))

    rerun_parser = subparsers.add_parser("rerun", help="Run programmatic Rerun capture")
    rerun_parser.add_argument("env")
    rerun_parser.add_argument("--dry-run", action="store_true")
    rerun_parser.set_defaults(func=lambda args, extra: rerun(args, extra))

    orbit_parser = subparsers.add_parser("orbit", help="Run orbit workflows")
    orbit_subparsers = orbit_parser.add_subparsers(dest="orbit_command", required=True)
    orbit_teleop_parser = orbit_subparsers.add_parser("teleop", help="Capture an orbit spec")
    orbit_teleop_parser.add_argument("env")
    orbit_teleop_parser.add_argument("--dry-run", action="store_true")
    orbit_teleop_parser.set_defaults(func=lambda args, extra: orbit_teleop(args, extra))
    orbit_render_parser = orbit_subparsers.add_parser("render", help="Render an orbit spec")
    orbit_render_parser.add_argument("env")
    orbit_render_parser.add_argument(
        "--preset",
        choices=["color-flashlight-only", "validation"],
        default="color-flashlight-only",
    )
    orbit_render_parser.add_argument("--dry-run", action="store_true")
    orbit_render_parser.set_defaults(func=lambda args, extra: orbit_render(args, extra))

    flythrough_parser = subparsers.add_parser("flythrough", help="Render a flythrough video")
    flythrough_parser.add_argument("env")
    flythrough_parser.add_argument("--dry-run", action="store_true")
    flythrough_parser.set_defaults(func=lambda args, extra: flythrough(args, extra))

    cook_parser = subparsers.add_parser("cook", help="Print the UAT cook command")
    cook_parser.add_argument("envs", nargs="+")
    cook_parser.add_argument("--dry-run", action="store_true")
    cook_parser.set_defaults(func=lambda args, extra: cook(args))

    return parser


def main(argv: list[str] | None = None) -> int:
    parser = build_parser()
    args, extra_args = parser.parse_known_args(argv)
    return args.func(args, strip_arg_separator(extra_args))


if __name__ == "__main__":
    raise SystemExit(main())
